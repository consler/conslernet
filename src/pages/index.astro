---
import "../styles/global.css";
import "../styles/index.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="About Consler" />
		<meta name="generator" content={Astro.generator} />
		<title>About Consler</title>
	</head>
  <body>
    <main class="container">
      <header class="hero">
        <h1>Consler here</h1>
      </header>

      <section class="about" aria-labelledby="details-title">
        <p>
          A guy who loves free and open source technology
        </p>

        <hr class="divider" aria-hidden="true">

        <h2 id="details-title">Details</h2>
        <ul class="personal-info" aria-label="Personal details">
          <li><span class="label">Pronouns</span>: <span class="description">he/him</span></li>
          <li><span class="label">My time</span>: <time id="consler-time" datetime="" aria-live="polite">—:—</time></li>
        </ul>
      </section>

      <section class="hobbies" aria-labelledby="hobbies-title">
        <h2 id="hobbies-title">Hobbies</h2>
        <ul class="personal-info hobby-list" aria-label="Hobbies">
          <li><span class="label">Coding</span>: <span class="description">Making cool open source projects for myself & others</span></li>
          <li><span class="label">Minecraft</span>: <span class="description">Working with redstone, commands, and speedrunning</span></li>
          </ul>
      </section>

      <p class="portfolio-link"><a class="button" href="/portfolio">View my portfolio</a></p>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <h2>Contact me</h2>
        <p>Email: <a href="mailto:consler2000@gmail.com">consler2000@gmail.com</a></p>
        <p>Discord: <span class="discord-handle">@consler</span></p>
      </div>
    </footer>

    <script>
      const el = document.querySelector<HTMLTimeElement>('#consler-time');
      if (el) {
        const formatter = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Berlin',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });

        const update = () => {
          const now = new Date();
          el.textContent = formatter.format(now);
          el.dateTime = now.toISOString();
        };

        update();
        setInterval(update, 30_000);
      }
    </script>
  </body>
</html>
